# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
DB_USER=nexus_user
DB_PASSWORD=nexus_password
DB_NAME=nexus_db
DB_PORT=5432
DB_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_db

# Authentication
JWT_SECRET=your_jwt_secret_change_in_production

# Voice Assistant (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
VOICE_MODEL=claude-haiku-5-5

# Optional Cloud Speech-to-Text Fallback
STT_PROVIDER=
STT_API_KEY=
